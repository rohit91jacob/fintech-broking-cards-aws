# Copy to .env (git-ignored). Every variable is optional.

# Where raw downloads, the Iceberg warehouse, the catalog and DuckDB live (default ./data).
FBC_DATA_DIR=./data

# SEC asks automated clients to identify themselves: "<name or project> <contact e-mail>".
FBC_SEC_USER_AGENT="fintech-broking-cards-aws portfolio-project contact@example.com"

# User-Agent for the NSE and RBI requests. It says what the client is; never a browser string.
# FBC_USER_AGENT="fintech-broking-cards-aws/0.1.0 (+https://github.com/rohit91jacob/fintech-broking-cards-aws)"

# NSE's Terms of Use prohibit automated data collection and the use of its data for
# simulation, so the NSE download is off (0). Set 1 only if NSE has given you permission.
# Without NSE files in $FBC_DATA_DIR/raw/nse the committed synthetic bhavcopies are used.
FBC_NSE_DOWNLOAD=0

# NSE sessions the raw gate may find missing in the requested window (exit 3 beyond it).
FBC_NSE_SESSION_TOLERANCE=0

# Where NSE/RBI files come from when the raw directory has none (default: tests/fixtures/raw).
# FBC_FIXTURE_DIR=./tests/fixtures/raw

# Simulation size and seed (the simulated event stream is deterministic for a seed).
FBC_SEED=20261009
FBC_TRADING_DAYS=10
FBC_CUSTOMERS=400
FBC_CARDS=1000
FBC_RBI_MONTHS=12
FBC_HOOD_FILINGS=12

# Leave unset to run every AWS call on in-process moto. Set to an emulator endpoint
# (LocalStack: http://localhost:4566) to use HTTP instead. Real AWS is never used.
# FBC_AWS_ENDPOINT_URL=http://localhost:4566
FBC_AWS_REGION=ap-south-1
FBC_RESOURCE_PREFIX=fbc-dev

# dbt target: dev | ci (DuckDB) | athena (compile only, no account needed)
DBT_TARGET=dev
